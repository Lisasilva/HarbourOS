# Copy to .env and fill in. .env is gitignored.

# Where the warehouse lives: a DuckDB file (use an absolute path, since dbt
# runs from dbt/) or md:harbouros for MotherDuck.
HARBOUROS_DB=/absolute/path/to/HarbourOS/data/ais_bronze.duckdb

# BarentsWatch API client (https://www.barentswatch.no/), scope "ais".
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=

# Only when HARBOUROS_DB starts with md:
MOTHERDUCK_TOKEN=
